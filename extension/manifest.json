{
  "manifest_version": 3,
  "name": "nama_DL",
  "version": "1.13.0",
  "description": "開いている動画・音声・サムネイルを保存するダウンローダー",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging",
    "cookies"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/nama_DL.png",
      "32": "icons/nama_DL.png",
      "48": "icons/nama_DL.png",
      "128": "icons/nama_DL.png"
    },
    "default_title": "nama_DL"
  },
  "short_name": "nama_DL",
  "icons": {
    "16": "icons/nama_DL.png",
    "32": "icons/nama_DL.png",
    "48": "icons/nama_DL.png",
    "128": "icons/nama_DL.png"
  },
  "host_permissions": [
    "https://*.nicovideo.jp/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nicovideo.jp/*",
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "sites.js",
        "edit-options.js",
        "queue-ui.js",
        "page.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
